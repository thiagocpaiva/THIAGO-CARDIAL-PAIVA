{
  "entities": {
    "branchData": {
      "title": "Branch Inventory Data",
      "description": "Inventory catalogs, counts and session state for a branch",
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "description": "Branch name (PAULO AFONSO or DELMIRO)",
          "enum": ["PAULO AFONSO", "DELMIRO"]
        },
        "materials": {
          "type": "array",
          "description": "Materials catalog list"
        },
        "freezers": {
          "type": "array",
          "description": "Freezers catalog list"
        },
        "equipments": {
          "type": "array",
          "description": "Equipments catalog list"
        },
        "materialCounts": {
          "type": "object",
          "description": "Daily counts of materials"
        },
        "equipmentCounts": {
          "type": "object",
          "description": "Daily counts of equipments"
        },
        "uncataloguedEquipments": {
          "type": "array",
          "description": "Uncatalogued items found during count"
        },
        "lastCountBackup": {
          "type": "object",
          "description": "Last saved count backup"
        },
        "activeContadorSession": {
          "type": "object",
          "description": "Active counter lock session"
        },
        "countStartedBy": {
          "type": "object",
          "description": "Counter user who initiated today's count"
        },
        "isReportSent": {
          "type": "boolean",
          "description": "Whether the stock report email has been sent for today's count"
        },
        "countDate": {
          "type": "string",
          "description": "Local YYYY-MM-DD date of the active count state"
        },
        "frozenReportText": {
          "type": "string",
          "description": "Frozen report preview text"
        },
        "recontagemSelectedIds": {
          "type": "object",
          "description": "Selected item IDs for recount"
        },
        "recontagemMaterialCounts": {
          "type": "object",
          "description": "Recount materials count entries"
        },
        "recontagemEquipmentCounts": {
          "type": "object",
          "description": "Recount equipments count entries"
        },
        "recontagemUnlocked": {
          "type": "boolean",
          "description": "Whether recount access has been released by Master to the initial or selected counter"
        },
        "recontagemTargetContador": {
          "type": "object",
          "description": "Specific counter user selected by Master for recount when initiated without an initial count"
        },
        "emailRecipients": {
          "type": "string",
          "description": "Configured email recipients text"
        },
        "emailSettings": {
          "type": "object",
          "description": "Branch email recipient list and default email"
        },
        "serverEmailConfig": {
          "type": "object",
          "description": "Branch email server configuration"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["branch"]
    },
    "appConfig": {
      "title": "Global Application Config",
      "description": "Global user accounts, email settings and logs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Config document identifier"
        },
        "users": {
          "type": "array",
          "description": "Registered application users"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/branches/{branchId}": {
      "schema": "branchData",
      "description": "Branch-specific inventory data and daily counts"
    },
    "/appConfig/{configId}": {
      "schema": "appConfig",
      "description": "Global application configuration and user profiles"
    }
  }
}
