        </div>

        {isBarril ? (
          /* BARRIL CONSOLIDADO */
          <div className="grid grid-cols-3 gap-2">
            <div className="bg-white border border-emerald-300 rounded-lg p-2 text-center shadow-2xs">
              <label className="text-[10px] font-black text-emerald-900 uppercase block mb-1">
                Cheio
              </label>
              <input
                type="number"
                min="0"
