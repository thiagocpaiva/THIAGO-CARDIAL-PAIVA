        disponivel: 0,
        danificado: 0,
        barrilCheio: 0,
        barrilVazio: 0,
        barrilEmRota: 0,
        co2Cheio: 0,
        co2Mexido: 0,
        co2Vazio: 0,
        co2EmRota: 0,
      };
      const updated = {
        ...prev,
        [itemId]: {
          ...current,
          ...data,
        }
      };
      localStorage.setItem(getBranchStorageKey(activeBranch, 'today_materials'), JSON.stringify(updated));
      broadcastSync('COUNT_UPDATED');
      return updated;
