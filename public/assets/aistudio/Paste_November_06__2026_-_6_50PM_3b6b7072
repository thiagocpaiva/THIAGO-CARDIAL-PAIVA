              />
            );
          })}
        </div>
      )}

      {/* Modal de Clonagem Seletiva */}
      <ModalClonarUltima
        isOpen={isCloneModalOpen}
        onClose={() => setIsCloneModalOpen(false)}
        onCloned={(msg) => {
          setCloneToast(`✅ ${msg}`);
          setTimeout(() => setCloneToast(null), 4000);
        }}
      />

    </div>
  );
};


