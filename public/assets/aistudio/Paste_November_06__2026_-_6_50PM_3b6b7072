import React, { useState, useRef, useEffect } from 'react';
import { 
  Plus, 
  Edit3, 
  Trash2, 
  Search, 
  Layers, 
  Snowflake, 
  Zap, 
  AlertTriangle,
  AlertCircle,
  Database,
  FileSpreadsheet,
  Download,
  Upload,
